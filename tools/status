#!/bin/bash
# tools/status of repo-standard: the read-only audit of the repositories of the standard,
# for the owner's regular audit. It runs from a clone of repo-standard, whose
# origin names the owner and repo-standard itself, and reads GitHub with gh, GET only.
#   tools/status [--checks LIST] [--owner OWNER] [--clones] [--sweep DIR] [--git-base URL]
#                [--allowed-signers FILE] [--token NAME=YYYY-MM-DD]... [--today YYYY-MM-DD]
#                [--now TIMESTAMP] REPO[=CLONE]...
# It prints one line per check, "<repo> <check> ok|warn|FAIL <reason>"; the sweep also prints
# "<repo> <short sha|#pr|tag> <kind>" per finding. It never prints a path, HOME, the list of
# repositories it was given, or a denylist term. The checks, run for every REPO:
#   standard  the MANIFEST's version and blob id against that release's MANIFEST asset; the lag
#             behind the newest release; RELEASE_KIND=legacy still set
#   settings  immutable releases; a read-only workflow token that cannot approve pull requests;
#             Dependabot alerts and security updates; squash merges only with PR_TITLE and
#             COMMIT_MESSAGES, merged branches deleted, no auto-merge; GitHub's visibility equal to
#             VISIBILITY; the Actions allow-list equal to actions.allow (temporary entries warn
#             until the adoption; github/codeql-action may stay) with SHA pinning; for a public
#             repository the standard ruleset exactly, secret scanning and push protection; where
#             the config says SEAL=yes, a tag ruleset that keeps every login from deleting or
#             moving refs/tags/seal/*, and none that blocks creating a seal
#   health    the last ci and secret-scan runs on main and the newest release's verify run are
#             green; no Dependabot pull request open more than 14 days; no draft waits to be
#             published
#   history   commits on main since the adoption that GitHub's web-flow did not make and that no
#             pull request merged into main brought in: a direct push, by short SHA only
#   seal      only where the config on main says SEAL=yes: the newest published release that is
#             not a pre-release and that github-actions[bot] drafted has its seal/vX.Y.Z, else a
#             warn for 24 hours after the publish and a FAIL from then on; each seal is an
#             annotated tag on the commit of its vX.Y.Z, with the message "<repo> vX.Y.Z". With
#             --sweep, a seal that moved or vanished since DIR/<repo>.seals first saw it is a
#             FAIL until its line goes from that file; with --allowed-signers FILE as well, each
#             seal verifies for maintainer in the mirror.
# With --clones, for each REPO=CLONE: the hooks are on, privacy.requireDenylist is on, the global
# includeIf lines exist, and the denylist loader finds sources and terms (counts only). With
# --sweep DIR, it keeps mirror clones of its own below DIR, cloned from --git-base (by default
# https://github.com/OWNER). Every branch and tag that moved since the last run goes through
# privacy-scan --range with this machine's denylists and the packs. The pull request texts and
# release notes changed since then are scanned too. Once per run: pins, the advisories of the
# pinned actions and the newer releases of the actions and tools, and with --token, each token's
# expiry. --checks limits the run to the listed checks. Exit 0 without a FAIL; 1 with one; 2 when
# the run cannot start; 64 usage.

# The gh calls, shared with tests/status.bats, which sources this file with STATUS_LIB=1.
RAW='Accept: application/vnd.github.raw'
JQ_SHA='.sha'
JQ_TAG='.tag_name'
JQ_RUN='.workflow_runs[0].conclusion // "none"'
JQ_DATES='.[].commit.committer.date'
JQ_DIRECT='.[] | [.sha, (.committer.login // ""), (.commit.verification.verified // false)] | @tsv'
JQ_MERGED='[.[] | select(.merged_at != null and .base.ref == "main")] | length'
JQ_REPO='[.private, .allow_squash_merge, .allow_merge_commit, .allow_rebase_merge, .squash_merge_commit_title, .squash_merge_commit_message, .delete_branch_on_merge, .allow_auto_merge, (.security_and_analysis.secret_scanning.status // "none"), (.security_and_analysis.secret_scanning_push_protection.status // "none")] | @tsv'
JQ_ENABLED='.enabled'
JQ_TOKEN='[.default_workflow_permissions, .can_approve_pull_request_reviews] | @tsv'
JQ_ACTIONS='[.enabled, .allowed_actions, .sha_pinning_required] | @tsv'
JQ_OWNED='[.github_owned_allowed, .verified_allowed] | @tsv'
JQ_PATTERNS='.patterns_allowed[]'
JQ_RULESETS='.[] | select(.target == "branch") | .id'
# The policy and the review count become text before first // "", since jq's // replaces
# false as well as null.
JQ_RULESET='[.enforcement, (.bypass_actors | length), ([.rules[].type] | sort | join(",")), ([.rules[] | select(.type == "required_status_checks") | .parameters.required_status_checks[] | "\(.context):\(.integration_id)"] | sort | join(",")), ([.rules[] | select(.type == "required_status_checks") | .parameters.strict_required_status_checks_policy | tostring] | first // ""), ([.rules[] | select(.type == "pull_request") | .parameters.required_approving_review_count | tostring] | first // "")] | @tsv'
JQ_TAG_RULESETS='.[] | select(.target == "tag") | .id'
JQ_TAG_RULESET='[.enforcement, (.bypass_actors | length), ([.rules[].type] | sort | join(",")), ((.conditions.ref_name.include // []) | sort | join(",")), ((.conditions.ref_name.exclude // []) | sort | join(","))] | @tsv'
JQ_DEPENDABOT='.[] | select(.user.login == "dependabot[bot]") | [.number, .created_at[0:10]] | @tsv'
JQ_DRAFTS='.[] | select(.draft) | .tag_name'
JQ_PRS='.[] | [.number, .updated_at] | @tsv'
JQ_PR_TEXT='.title, (.body // "")'
JQ_RELEASES='.[] | select(.draft | not) | [.id, .tag_name] | @tsv'
JQ_RELEASE_TEXT='(.name // ""), (.body // "")'
JQ_GHSA='.[].ghsa_id'
JQ_LATEST='[.tag_name, ((.published_at // "")[0:10])] | @tsv'
JQ_SEALABLE='.[] | select((.draft | not) and (.prerelease | not)) | [.tag_name, (.published_at // ""), (.author.login // "")] | @tsv'
JQ_REFS='.[] | [.ref, .object.type, .object.sha] | @tsv'
JQ_OBJECT='[.object.type, .object.sha] | @tsv'
JQ_SEAL='[.object.type, .object.sha, (.message | split("\n") | .[0])] | @tsv'
# The standard ruleset of a public repository after its adoption.
# The tag ruleset of a repository that seals: deletion and update of every seal, for every login.
SEAL_RULESET=$'active\t0\tdeletion,update\trefs/tags/seal/*\t'
STANDARD_RULESET=$'active\t0\tdeletion,non_fast_forward,pull_request,required_status_checks\tall-passed:15368,scan:15368\tfalse\t0'

# Run gh read-only: gh api with GET and no field, since a field makes it POST, or gh release
# download. Anything else returns 97 before gh runs.
ghr() {
    local arg prev=''
    case ${1:-} in
        api)
            for arg in "$@"; do
                case $prev in
                    -X | --method) [[ $arg == GET ]] || return 97 ;;
                esac
                case $arg in
                    -f | -F | --field | --raw-field | --input | -f?* | -F?* | --field=* | --raw-field=* | --input=*)
                        return 97 ;;
                    --method=* | -X?*) [[ $arg == --method=GET || $arg == -XGET ]] || return 97 ;;
                esac
                prev=$arg
            done
            ;;
        release) [[ ${2:-} == download ]] || return 97 ;;
        *) return 97 ;;
    esac
    gh "$@"
}

# "owner/repo X.Y.Z" for each action the workflows of the clone $1 pin.
pinned_actions() {
    sed -n 's/^[[:space:]-]*uses:[[:space:]]*\([A-Za-z0-9_.-]*\/[A-Za-z0-9_.-]*\)@[0-9a-f]\{40\} # v\([0-9.]*\)[[:space:]]*$/\1 \2/p' \
        "$1"/.github/workflows/*.yml | LC_ALL=C sort -u
}

# "tool owner/repo version" for each tool that install-tools of the clone $1 pins, and BuildKit.
pinned_tools() {
    local name version
    while IFS='=' read -r name version; do
        case $name in
            BATS) printf 'bats bats-core/bats-core %s\n' "$version" ;;
            SHELLCHECK) printf 'shellcheck koalaman/shellcheck %s\n' "$version" ;;
            ACTIONLINT) printf 'actionlint rhysd/actionlint %s\n' "$version" ;;
            HADOLINT) printf 'hadolint hadolint/hadolint %s\n' "$version" ;;
            GITLEAKS) printf 'gitleaks gitleaks/gitleaks %s\n' "$version" ;;
            PESTER) printf 'pester pester/Pester %s\n' "$version" ;;
            PSSCRIPTANALYZER) printf 'psscriptanalyzer PowerShell/PSScriptAnalyzer %s\n' "$version" ;;
        esac
    done < <(sed -n 's/^readonly \([A-Z]*\)_VERSION=\([0-9.]*\)$/\1=\2/p' "$1/.github/standard/bin/install-tools")
    sed -n 's/.*image=moby\/buildkit:v\([0-9.]*\)@sha256:.*/buildkit moby\/buildkit \1/p' \
        "$1/.github/workflows/image.yml" | head -n 1
}

# True when version $1 is newer than version $2 (a leading v ignored).
newer() {
    local a=${1#v} b=${2#v}
    [[ $a != "$b" && $(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n 1) == "$a" ]]
}

[[ ${STATUS_LIB:-} != 1 ]] || return 0

set -euo pipefail
usage() {
    echo "usage: tools/status [--checks LIST] [--owner OWNER] [--clones] [--sweep DIR] [--git-base URL]" >&2
    echo "                    [--allowed-signers FILE] [--token NAME=YYYY-MM-DD]... [--today YYYY-MM-DD]" >&2
    echo "                    [--now TIMESTAMP] REPO[=CLONE]..." >&2
    exit 64
}

checks=standard,settings,health,history,clones,sweep,seal,pins,tokens
owner=''
clones=0
sweep=''
git_base=''
allowed_signers=''
today=$(date -u +%F)
now=$(date -u +%FT%TZ)
tokens=()
repos=()
while (( $# )); do
    case $1 in
        --checks) [[ ${2:-} =~ ^[a-z,]+$ ]] || usage; checks=$2; shift ;;
        --owner) [[ ${2:-} =~ ^[A-Za-z0-9-]+$ ]] || usage; owner=$2; shift ;;
        --clones) clones=1 ;;
        --sweep) [[ -n ${2:-} ]] || usage; sweep=$2; shift ;;
        --git-base) [[ -n ${2:-} ]] || usage; git_base=$2; shift ;;
        --allowed-signers) [[ -n ${2:-} ]] || usage; allowed_signers=$2; shift ;;
        --token) [[ ${2:-} =~ ^[A-Za-z0-9_.-]+=[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || usage; tokens+=("$2"); shift ;;
        --today) [[ ${2:-} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || usage; today=$2; shift ;;
        --now) [[ ${2:-} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$ ]] || usage; now=$2; shift ;;
        -*) usage ;;
        *) [[ $1 =~ ^[A-Za-z0-9_.-]+(=.+)?$ ]] || usage; repos+=("$1") ;;
    esac
    shift
done
wants() { [[ ,$checks, == *",$1,"* ]]; }
# The seals' signatures are checked in the sweep's mirrors.
[[ -z $allowed_signers || -n $sweep ]] || usage
if [[ -n $allowed_signers && ! -f $allowed_signers ]]; then
    echo "status: --allowed-signers names no file" >&2
    exit 2
fi

src=$(CDPATH='' cd -- "${BASH_SOURCE[0]%/*}/.." && pwd)
src=$(git -C "$src" rev-parse --show-toplevel 2> /dev/null) || {
    echo "status: tools/status runs from a clone of repo-standard" >&2
    exit 2
}
url=$(git -C "$src" remote get-url origin 2> /dev/null) || url=''
rs=${url%/}
rs=${rs%.git}
rs=${rs#https://github.com/}
rs=${rs#git@github.com:}
rs=${rs#ssh://git@github.com/}
[[ $rs =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
    echo "status: the clone's origin names no repository on github.com" >&2
    exit 2
}
owner=${owner:-${rs%%/*}}
git_base=${git_base:-https://github.com/$owner}
umask 077
tmp=$(mktemp -d "${TMPDIR:-/tmp}/status.XXXXXX") || exit 2
trap 'rm -rf -- "$tmp"' EXIT
# A copy with LF line ends at an absolute path, since git reads the file in each mirror.
if [[ -n $allowed_signers ]]; then
    tr -d '\r' < "$allowed_signers" > "$tmp/allowed_signers" || exit 2
    allowed_signers=$tmp/allowed_signers
fi
sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$src/.github/standard/actions.allow" |
    tr -d '\r' | LC_ALL=C sort -u > "$tmp/allow"

fails=0
level=ok
reasons=()
# Record a finding of the check being run: note warn|FAIL REASON.
note() {
    case $1 in
        FAIL) level=FAIL ;;
        warn) [[ $level == FAIL ]] || level=warn ;;
    esac
    reasons+=("$2")
}
# Print the line of the check $2 of $1, with the reason $3 when nothing was noted.
emit() {
    local text=$3 r
    if (( ${#reasons[@]} )); then
        text=''
        for r in "${reasons[@]}"; do text+="${text:+; }$r"; done
    fi
    printf '%s %s %s %s\n' "$1" "$2" "$level" "$text"
    [[ $level != FAIL ]] || fails=$((fails + 1))
    level=ok
    reasons=()
}
# Days from the date $1 to the date $2.
days() {
    echo $(( ($(date -u -d "$2" +%s) - $(date -u -d "$1" +%s)) / 86400 ))
}
# The file at $2 on main of the repository $1, raw, into the file $3; false when it is missing.
fetch() {
    ghr api -H "$RAW" "repos/$1/contents/$2?ref=main" > "$3" 2> /dev/null
}
newest=''
# The blob id of the MANIFEST asset of the release vX.Y.Z ($1) of repo-standard.
asset_of() {
    local folder=$tmp/rs-$1
    if [[ ! -f $folder/MANIFEST ]]; then
        mkdir -p "$folder"
        ghr release download "v$1" -R "$rs" --pattern MANIFEST --dir "$folder" > /dev/null 2>&1 || return 1
    fi
    git hash-object --no-filters "$folder/MANIFEST"
}
# True when the repository $1 has a MANIFEST on main.
adopted() {
    ghr api "repos/$1/contents/.github/standard/MANIFEST?ref=main" --jq "$JQ_SHA" > /dev/null 2>&1
}

check_standard() {
    local r=$1 s=$owner/$1 sha version='' asset
    if ! sha=$(ghr api "repos/$s/contents/.github/standard/MANIFEST?ref=main" --jq "$JQ_SHA" 2> /dev/null); then
        note warn "not adopted yet: no .github/standard/MANIFEST on main"
        emit "$r" standard ""
        return
    fi
    if fetch "$s" .github/standard/MANIFEST "$tmp/$r.manifest"; then
        version=$(awk '$1 == "standard" && NF == 2 { print $2; exit }' "$tmp/$r.manifest")
    else
        note FAIL "cannot read the MANIFEST"
    fi
    # repo-standard itself writes its MANIFEST from its tree; no release holds it before the tag.
    if fetch "$s" .github/standard.conf "$tmp/$r.conf" && grep -q -x 'ROLE=source' "$tmp/$r.conf"; then
        emit "$r" standard "the source of the standard, at $version"
        return
    fi
    if [[ ! $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        note FAIL "the MANIFEST names no released version"
    elif ! asset=$(asset_of "$version"); then
        note FAIL "repo-standard has no MANIFEST asset for v$version"
    elif [[ $asset != "$sha" ]]; then
        note FAIL "the MANIFEST differs from the v$version asset"
    fi
    if [[ -z $newest ]]; then
        newest=$(ghr api "repos/$rs/releases/latest" --jq "$JQ_TAG" 2> /dev/null) || newest=unknown
    fi
    if [[ $newest == unknown ]]; then
        note warn "cannot read repo-standard's newest release"
    elif [[ -n $version ]] && newer "$newest" "$version"; then
        note warn "$version, the newest release is ${newest#v}"
    fi
    if fetch "$s" .github/standard.conf "$tmp/$r.conf" && grep -q -x 'RELEASE_KIND=legacy' "$tmp/$r.conf"; then
        note warn "RELEASE_KIND=legacy until the release adoption"
    fi
    emit "$r" standard "$version, equal to the release's MANIFEST asset"
}

# The tag rulesets of a repository that seals, $1 as OWNER/NAME. One of them must be exactly
# SEAL_RULESET, so no login deletes or moves a seal. None that is active may restrict creating a
# tag under refs/tags/seal/, or the seal tool's push of a new seal fails.
check_tag_rulesets() {
    local s=$1 ids id v protected=0 blocked=0
    if ! ids=$(ghr api "repos/$s/rulesets" --jq "$JQ_TAG_RULESETS" 2> /dev/null); then
        note FAIL "cannot read the tag rulesets"
        return 0
    fi
    while IFS= read -r id; do
        [[ -n $id ]] || continue
        if ! v=$(ghr api "repos/$s/rulesets/$id" --jq "$JQ_TAG_RULESET" 2> /dev/null); then
            note FAIL "cannot read tag ruleset $id"
            continue
        fi
        [[ $v != "$SEAL_RULESET" ]] || protected=1
        if [[ $(cut -f 1 <<< "$v") == active && ,$(cut -f 3 <<< "$v"), == *,creation,* ]]; then
            case ,$(cut -f 4 <<< "$v"), in
                *",refs/tags/seal/*,"* | *",refs/tags/*,"* | *",~ALL,"*) blocked=1 ;;
            esac
        fi
    done <<< "$ids"
    (( protected )) || note FAIL "no tag ruleset blocks deleting and moving the seal tags"
    if (( blocked )); then note FAIL "a tag ruleset blocks creating a seal"; fi
    return 0
}

check_settings() {
    local r=$1 s=$owner/$1 is_adopted=0 vis='' v private squash merge rebase title message delete auto
    local scanning push token approve enabled allowed pinning owned verified rules id pattern
    local seals=0
    adopted "$s" && is_adopted=1
    if fetch "$s" .github/standard.conf "$tmp/$r.conf"; then
        vis=$(sed -n 's/^VISIBILITY=\([a-z]*\)$/\1/p' "$tmp/$r.conf" | head -n 1)
        ! grep -q -x 'SEAL=yes' "$tmp/$r.conf" || seals=1
    fi
    if v=$(ghr api "repos/$s" --jq "$JQ_REPO" 2> /dev/null); then
        IFS=$'\t' read -r private squash merge rebase title message delete auto scanning push <<< "$v"
        [[ $squash == true ]] || note FAIL "squash merges are off"
        [[ $merge == false ]] || note FAIL "merge commits are allowed"
        [[ $rebase == false ]] || note FAIL "rebase merges are allowed"
        [[ $title == PR_TITLE ]] || note FAIL "squash titles are not PR_TITLE"
        [[ $message == COMMIT_MESSAGES ]] || note FAIL "squash messages are not COMMIT_MESSAGES"
        [[ $delete == true ]] || note FAIL "merged branches stay"
        [[ $auto == false ]] || note FAIL "auto-merge is allowed"
        if [[ $private == true && $vis == public ]]; then
            note FAIL "VISIBILITY=public, but GitHub shows it private"
        elif [[ $private == false && $vis == private ]]; then
            note FAIL "VISIBILITY=private, but GitHub shows it public"
        fi
        if [[ $private == false ]]; then
            [[ $scanning == enabled ]] || note FAIL "secret scanning is off"
            [[ $push == enabled ]] || note FAIL "push protection is off"
            rules=''
            id=$(ghr api "repos/$s/rulesets" --jq "$JQ_RULESETS" 2> /dev/null | head -n 1) || id=''
            [[ -z $id ]] || rules=$(ghr api "repos/$s/rulesets/$id" --jq "$JQ_RULESET" 2> /dev/null) || rules=''
            if [[ -z $rules ]]; then
                note FAIL "no branch ruleset"
            elif (( is_adopted )); then
                [[ $rules == "$STANDARD_RULESET" ]] || note FAIL "the ruleset differs from the standard one"
            elif [[ $(cut -f 3 <<< "$rules") != *deletion*non_fast_forward* ]]; then
                note FAIL "the ruleset does not block deletion and force pushes"
            fi
        fi
    else
        note FAIL "cannot read the repository"
    fi
    v=$(ghr api "repos/$s/immutable-releases" --jq "$JQ_ENABLED" 2> /dev/null) || v=''
    [[ $v == true ]] || note FAIL "immutable releases are off"
    (( ! seals )) || check_tag_rulesets "$s"
    if v=$(ghr api "repos/$s/actions/permissions/workflow" --jq "$JQ_TOKEN" 2> /dev/null); then
        IFS=$'\t' read -r token approve <<< "$v"
        [[ $token == read ]] || note FAIL "the workflow token may write"
        [[ $approve == false ]] || note FAIL "Actions may approve pull requests"
    else
        note FAIL "cannot read the workflow token's permissions"
    fi
    ghr api "repos/$s/vulnerability-alerts" > /dev/null 2>&1 || note FAIL "Dependabot alerts are off"
    v=$(ghr api "repos/$s/automated-security-fixes" --jq "$JQ_ENABLED" 2> /dev/null) || v=''
    [[ $v == true ]] || note FAIL "Dependabot security updates are off"
    if v=$(ghr api "repos/$s/actions/permissions" --jq "$JQ_ACTIONS" 2> /dev/null); then
        IFS=$'\t' read -r enabled allowed pinning <<< "$v"
        [[ $enabled == true ]] || note warn "Actions are off"
        [[ $allowed == selected ]] || note FAIL "Actions may run any action, not the selected ones"
        [[ $pinning == true ]] || note FAIL "SHA pinning is off"
    else
        note FAIL "cannot read the Actions permissions"
    fi
    if v=$(ghr api "repos/$s/actions/permissions/selected-actions" --jq "$JQ_OWNED" 2> /dev/null); then
        IFS=$'\t' read -r owned verified <<< "$v"
        [[ $owned == false ]] || note FAIL "every action GitHub created is allowed"
        [[ $verified == false ]] || note FAIL "every action of a verified creator is allowed"
    fi
    if ghr api "repos/$s/actions/permissions/selected-actions" --jq "$JQ_PATTERNS" 2> /dev/null |
        tr -d '\r' | LC_ALL=C sort -u > "$tmp/$r.patterns"; then
        pattern=$(LC_ALL=C comm -23 "$tmp/allow" "$tmp/$r.patterns" | paste -s -d ' ' -)
        [[ -z $pattern ]] || note FAIL "the allow-list lacks $pattern"
        pattern=$(LC_ALL=C comm -13 "$tmp/allow" "$tmp/$r.patterns" | { grep -v '^github/codeql-action' || true; } |
            paste -s -d ' ' -)
        if [[ -n $pattern ]]; then
            if (( is_adopted )); then note FAIL "beyond actions.allow: $pattern"; else note warn "until the adoption: $pattern"; fi
        fi
    else
        note FAIL "cannot read the Actions allow-list"
    fi
    emit "$r" settings "as the standard sets them"
}

check_health() {
    local r=$1 s=$owner/$1 v workflow number created
    if adopted "$s"; then
        for workflow in ci secret-scan; do
            v=$(ghr api "repos/$s/actions/workflows/$workflow.yml/runs?branch=main&per_page=1" --jq "$JQ_RUN" 2> /dev/null) || v=unreadable
            [[ $v == success ]] || note FAIL "$workflow on main ended with $v"
        done
        v=$(ghr api "repos/$s/actions/workflows/release.yml/runs?event=release&per_page=1" --jq "$JQ_RUN" 2> /dev/null) || v=none
        [[ $v == success || $v == none ]] || note FAIL "verify of the newest release ended with $v"
    fi
    while IFS=$'\t' read -r number created; do
        [[ -n $number ]] || continue
        v=$(days "$created" "$today")
        (( v <= 14 )) || note warn "Dependabot #$number is open $v days"
    done < <(ghr api --paginate "repos/$s/pulls?state=open&per_page=100" --jq "$JQ_DEPENDABOT" 2> /dev/null || true)
    while IFS= read -r v; do
        [[ -z $v ]] || note warn "draft $v waits for Publish"
    done < <(ghr api --paginate "repos/$s/releases?per_page=100" --jq "$JQ_DRAFTS" 2> /dev/null || true)
    emit "$r" health "the last runs on main are green"
}

check_history() {
    local r=$1 s=$owner/$1 since rows sha login verified merged direct='' unknown=''
    since=$(ghr api --paginate "repos/$s/commits?sha=main&path=.github/standard/MANIFEST&per_page=100" \
        --jq "$JQ_DATES" 2> /dev/null | tail -n 1) || since=''
    if [[ -z $since ]]; then
        emit "$r" history "not adopted yet"
        return
    fi
    # A merge in the browser or through the API is GitHub's commit: web-flow commits it and GitHub's
    # signature on it verifies. A committer set to web-flow by hand has no such signature. A merge
    # commit also brings its branch's own commits onto main, committed by their author: one GET per
    # such commit asks whether a pull request merged into main brought it in. A direct push has
    # none, and a GET that fails accepts nothing.
    if rows=$(ghr api --paginate "repos/$s/commits?sha=main&since=$since&per_page=100" \
        --jq "$JQ_DIRECT" 2> /dev/null); then
        while IFS=$'\t' read -r sha login verified; do
            [[ -n $sha ]] || continue
            [[ $login == web-flow && $verified == true ]] && continue
            if merged=$(ghr api "repos/$s/commits/$sha/pulls" --jq "$JQ_MERGED" 2> /dev/null); then
                [[ $merged =~ ^[1-9][0-9]*$ ]] && continue
                direct+=" ${sha:0:7}"
            else
                unknown+=" ${sha:0:7}"
            fi
        done <<< "$rows"
        [[ -z $direct ]] || note FAIL "a direct push to main:$direct"
        [[ -z $unknown ]] ||
            note FAIL "cannot tell whether these came through a pull request:$unknown"
    else
        note FAIL "cannot read the commits of main"
    fi
    emit "$r" history "every commit since the adoption came through a pull request"
}

check_clone() {
    local r=$1 clone=$2 top hooks state='hooks on' counts includes sources terms missing nul
    if ! top=$(git -C "$clone" rev-parse --show-toplevel 2> /dev/null); then
        note FAIL "the clone given is not a git work tree"
        emit "$r" clones ""
        return
    fi
    hooks=$(git -C "$top" rev-parse --path-format=absolute --git-path hooks)
    [[ $hooks -ef $top/.githooks ]] || { note FAIL "the hooks are off"; state='hooks off'; }
    [[ $(git -C "$top" config --type=bool --get privacy.requireDenylist 2> /dev/null) == true ]] ||
        note FAIL "requireDenylist is not on"
    includes=$(git config --global --get-regexp '^includeif\..*\.path$' 2> /dev/null |
        OWNER=$owner NAME=$r awk '{
            k = $1; tail = ENVIRON["OWNER"] "/" ENVIRON["NAME"]
            if (index(k, "/" tail ".") || index(k, ":" tail ".")) n++
        } END { print n + 0 }')
    (( includes > 0 )) || note FAIL "no includeIf line names this repository"
    counts=$(cd "$top" && std_hook=status std_here=$src/.githooks &&
        . "$src/.githooks/lib.sh" && deny_load > /dev/null 2>&1 &&
        printf '%s %s %s %s' "$deny_sources" "$deny_terms" "$deny_missing" "$deny_nul" 2> /dev/null) || counts=''
    read -r sources terms missing nul <<< "${counts:-0 0 0 0}"
    (( sources > 0 && terms > 0 )) || note FAIL "the denylist loader finds no term"
    (( missing == 0 )) || note FAIL "$missing denylist(s) missing"
    (( nul == 0 )) || note FAIL "$nul denylist(s) with NUL bytes"
    emit "$r" clones "$state, requireDenylist on, $includes includeIf line(s), $sources denylist source(s), $terms term(s)"
}

# Run privacy-scan in the mirror $1 with the remaining arguments, and print each kind it finds
# once. Returns 2 when the scan cannot run.
scan_kinds() {
    local mirror=$1 rc=0
    shift
    (cd "$mirror" && sh "$src/.githooks/privacy-scan" "$@") < /dev/null > /dev/null 2> "$tmp/scan.err" || rc=$?
    case $rc in
        0) return 0 ;;
        1) sed -n 's/^privacy-scan: .*: \([a-z0-9-]*\)$/\1/p' "$tmp/scan.err" | LC_ALL=C sort -u ;;
        *) return 2 ;;
    esac
}

check_sweep() {
    local r=$1 s=$owner/$1 mirror=$sweep/$1.git seenf=$sweep/$1.seen sincef=$sweep/$1.since since=''
    local notesf=$sweep/$1.notes ref sha kinds k number updated id tag hash refs=0 found=0 texts=0 errors=0
    local -a seen=()
    mkdir -p "$sweep"
    if [[ -d $mirror ]]; then
        git -C "$mirror" fetch -q --prune 2> /dev/null || { note FAIL "cannot fetch the mirror"; emit "$r" sweep ""; return; }
    else
        git clone -q --mirror "$git_base/$r.git" "$mirror" 2> /dev/null ||
            { note FAIL "cannot make the mirror"; emit "$r" sweep ""; return; }
    fi
    [[ ! -f $sincef ]] || since=$(cat "$sincef")
    if [[ -f $seenf ]]; then
        while read -r _ sha; do
            if git -C "$mirror" cat-file -e "$sha^{commit}" 2> /dev/null; then seen+=("$sha"); fi
        done < "$seenf"
    fi
    git -C "$mirror" for-each-ref --format='%(refname) %(objectname)' refs/heads refs/tags > "$tmp/$r.refs"
    while read -r ref sha; do
        if [[ -f $seenf ]] && grep -q -x -F "$ref $sha" "$seenf"; then continue; fi
        refs=$((refs + 1))
        if ! kinds=$(scan_kinds "$mirror" --range "$sha" --not "${seen[@]}"); then
            note FAIL "cannot scan ${sha:0:7}"
            errors=$((errors + 1))
            continue
        fi
        while IFS= read -r k; do
            [[ -n $k ]] || continue
            printf '%s %s %s\n' "$r" "$(git -C "$mirror" rev-parse --short=7 "$sha^{commit}")" "$k"
            found=$((found + 1))
        done <<< "$kinds"
        seen+=("$sha")
    done < "$tmp/$r.refs"
    while IFS=$'\t' read -r number updated; do
        [[ -n $number ]] || continue
        [[ -z $since || $updated > $since ]] || continue
        if ! ghr api "repos/$s/pulls/$number" --jq "$JQ_PR_TEXT" > "$tmp/text" 2> /dev/null; then
            note FAIL "cannot read #$number"
            errors=$((errors + 1))
            continue
        fi
        texts=$((texts + 1))
        if ! kinds=$(scan_kinds "$mirror" --message "$tmp/text"); then
            note FAIL "cannot scan #$number"
            errors=$((errors + 1))
            continue
        fi
        while IFS= read -r k; do
            if [[ -n $k ]]; then printf '%s #%s %s\n' "$r" "$number" "$k"; found=$((found + 1)); fi
        done <<< "$kinds"
    done < <(ghr api --paginate "repos/$s/pulls?state=all&sort=updated&direction=desc&per_page=100" --jq "$JQ_PRS" 2> /dev/null || true)
    # A release's notes can change after the publish without a date that shows it. So every
    # release's text is read, and scanned when its SHA-256 differs from the last run's.
    : > "$tmp/$r.notes"
    while IFS=$'\t' read -r id tag; do
        [[ -n $id ]] || continue
        if ! ghr api "repos/$s/releases/$id" --jq "$JQ_RELEASE_TEXT" > "$tmp/text" 2> /dev/null; then
            note FAIL "cannot read $tag"
            errors=$((errors + 1))
            continue
        fi
        hash=$(sha256sum < "$tmp/text" | cut -c 1-64)
        printf '%s %s\n' "$id" "$hash" >> "$tmp/$r.notes"
        if [[ -f $notesf ]] && grep -q -x -F "$id $hash" "$notesf"; then continue; fi
        texts=$((texts + 1))
        if ! kinds=$(scan_kinds "$mirror" --message "$tmp/text"); then
            note FAIL "cannot scan $tag"
            errors=$((errors + 1))
            continue
        fi
        while IFS= read -r k; do
            if [[ -n $k ]]; then printf '%s %s %s\n' "$r" "$tag" "$k"; found=$((found + 1)); fi
        done <<< "$kinds"
    done < <(ghr api --paginate "repos/$s/releases?per_page=100" --jq "$JQ_RELEASES" 2> /dev/null || true)
    (( found == 0 )) || note FAIL "$found finding(s)"
    # Progress is saved only when every ref and text was read and scanned, so a run that failed
    # anywhere scans the same again next time; findings are reported, and do not hold it back.
    if (( errors == 0 )); then
        cp "$tmp/$r.refs" "$seenf"
        cp "$tmp/$r.notes" "$notesf"
        printf '%s\n' "$now" > "$sincef"
    fi
    emit "$r" sweep "$refs ref(s) and $texts text(s) scanned"
}

# The commit of the tag $2 of the repository $1, through an annotated tag too; false without one.
tag_commit() {
    local v type sha
    v=$(ghr api "repos/$1/git/ref/tags/$2" --jq "$JQ_OBJECT" 2> /dev/null) || return 1
    IFS=$'\t' read -r type sha <<< "${v%$'\r'}"
    if [[ $type == tag ]]; then
        v=$(ghr api "repos/$1/git/tags/$sha" --jq "$JQ_OBJECT" 2> /dev/null) || return 1
        IFS=$'\t' read -r type sha <<< "${v%$'\r'}"
    fi
    [[ $type == commit && $sha =~ ^[0-9a-f]{40}$ ]] || return 1
    printf '%s\n' "$sha"
}

check_seal() {
    local r=$1 s=$owner/$1 ref type sha v otype osha subject commit tag published author newest='' when=''
    local hours state=$sweep/$1.seals mirror=$sweep/$1.git errors=0
    if ! fetch "$s" .github/standard.conf "$tmp/$r.conf" || ! grep -q -x 'SEAL=yes' "$tmp/$r.conf"; then
        return 0
    fi
    if ! ghr api --paginate "repos/$s/git/matching-refs/tags/seal/v" --jq "$JQ_REFS" 2> /dev/null |
        tr -d '\r' > "$tmp/$r.seals"; then
        note FAIL "cannot read the seals"
        emit "$r" seal ""
        return
    fi
    : > "$tmp/$r.sealed"
    while IFS=$'\t' read -r ref type sha; do
        [[ -n $ref ]] || continue
        tag=${ref#refs/tags/seal/}
        printf '%s\n' "$tag" >> "$tmp/$r.sealed"
        if [[ $type != tag ]]; then
            note FAIL "seal/$tag is not an annotated tag"
            continue
        fi
        if ! v=$(ghr api "repos/$s/git/tags/$sha" --jq "$JQ_SEAL" 2> /dev/null); then
            note FAIL "cannot read seal/$tag"
            errors=1
            continue
        fi
        IFS=$'\t' read -r otype osha subject <<< "${v%$'\r'}"
        [[ $subject == "$r $tag" ]] || note FAIL "the message of seal/$tag is not \"$r $tag\""
        if ! commit=$(tag_commit "$s" "$tag"); then
            note FAIL "seal/$tag has no release tag $tag"
        elif [[ $otype != commit || $osha != "$commit" ]]; then
            note FAIL "seal/$tag is not on the commit of $tag"
        fi
    done < "$tmp/$r.seals"
    # The newest published release that is not a pre-release waits for its Seal click. Only the
    # release workflow's releases count: the seal tool seals no other, and a release that the
    # owner made by hand before SEAL=yes has its own signed tag.
    if ghr api --paginate "repos/$s/releases?per_page=100" --jq "$JQ_SEALABLE" 2> /dev/null |
        tr -d '\r' > "$tmp/$r.sealable"; then
        while IFS=$'\t' read -r tag published author; do
            [[ $author == 'github-actions[bot]' ]] || continue
            [[ $tag =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || continue
            if [[ -z $newest ]] || newer "$tag" "$newest"; then newest=$tag; when=$published; fi
        done < "$tmp/$r.sealable"
    else
        note FAIL "cannot read the releases"
        errors=1
    fi
    if [[ -n $newest ]] && ! grep -q -x -F -e "$newest" "$tmp/$r.sealed"; then
        hours=0
        [[ -z $when ]] || hours=$(( ($(date -u -d "$now" +%s) - $(date -u -d "$when" +%s)) / 3600 ))
        if (( hours < 24 )); then
            note warn "$newest waits for its Seal click"
        else
            note FAIL "$newest has waited $hours hours for its seal"
        fi
    fi
    if [[ -n $sweep ]]; then
        # A seal never moves: each is kept as first seen, and a change of it fails every run.
        mkdir -p "$sweep"
        [[ -f $state ]] || : > "$state"
        awk -F '\t' '{ print $1 " " $3 }' "$tmp/$r.seals" > "$tmp/$r.seals.now"
        while read -r ref sha; do
            [[ -n $ref ]] || continue
            v=$(awk -v r="$ref" '$1 == r { print $2; exit }' "$tmp/$r.seals.now")
            if [[ -z $v ]]; then note FAIL "${ref#refs/tags/} vanished"
            elif [[ $v != "$sha" ]]; then note FAIL "${ref#refs/tags/} moved"
            fi
        done < "$state"
        if (( errors == 0 )); then
            awk 'NR == FNR { seen[$1] = 1; print; next } !($1 in seen)' "$state" "$tmp/$r.seals.now" \
                > "$tmp/$r.seals.state" && cp "$tmp/$r.seals.state" "$state"
        fi
        if [[ -n $allowed_signers ]]; then
            while IFS=$'\t' read -r ref type sha; do
                [[ -n $ref && $type == tag ]] || continue
                if [[ ! -d $mirror ]] || ! git -C "$mirror" cat-file -e "$sha" 2> /dev/null; then
                    note warn "${ref#refs/tags/} is not in the sweep's mirror yet"
                elif ! git -C "$mirror" -c gpg.ssh.program=ssh-keygen -c gpg.ssh.allowedSignersFile="$allowed_signers" \
                    verify-tag "$sha" > /dev/null 2> "$tmp/verify" ||
                    ! grep -q 'Good "git" signature for maintainer with' "$tmp/verify"; then
                    note FAIL "${ref#refs/tags/} does not verify for maintainer"
                fi
            done < "$tmp/$r.seals"
        fi
    fi
    if [[ -n $newest ]]; then emit "$r" seal "$newest is sealed"; else emit "$r" seal "no release yet"; fi
}

check_pins() {
    local action version tag published tool repo hits
    while read -r action version; do
        hits=$(ghr api "advisories?ecosystem=actions&affects=$action@$version" --jq "$JQ_GHSA" 2> /dev/null |
            paste -s -d ' ' -) || hits=''
        [[ -z $hits ]] || note FAIL "$action $version: $hits"
        if IFS=$'\t' read -r tag published < <(ghr api "repos/$action/releases/latest" --jq "$JQ_LATEST" 2> /dev/null); then
            if newer "$tag" "$version" && [[ -n $published ]] && (( $(days "$published" "$today") >= 14 )); then
                note warn "$action $tag is out"
            fi
        fi
    done < <(pinned_actions "$src")
    while read -r tool repo version; do
        if IFS=$'\t' read -r tag published < <(ghr api "repos/$repo/releases/latest" --jq "$JQ_LATEST" 2> /dev/null); then
            if newer "$tag" "$version" && [[ -n $published ]] && (( $(days "$published" "$today") >= 14 )); then
                note warn "$tool $tag is out"
            fi
        fi
    done < <(pinned_tools "$src")
    emit "${rs#*/}" pins "no advisory, and no newer release for 14 days"
}

check_token() {
    local name=${1%%=*} date=${1#*=} left
    left=$(days "$today" "$date")
    if (( left < 0 )); then
        note FAIL "expired $(( -left )) days ago"
    elif (( left <= 30 )); then
        note warn "expires in $left days"
    fi
    emit "$name" tokens "expires in $left days"
}

for spec in "${repos[@]}"; do
    name=${spec%%=*}
    for check in standard settings health history; do
        if wants "$check"; then "check_$check" "$name"; fi
    done
    if (( clones )) && wants clones && [[ $spec == *=* ]]; then check_clone "$name" "${spec#*=}"; fi
    if [[ -n $sweep ]] && wants sweep; then check_sweep "$name"; fi
    # Runs after the sweep, since the seals' signatures are checked in its mirror.
    if wants seal; then check_seal "$name"; fi
done
if wants pins; then check_pins; fi
if wants tokens; then
    for spec in "${tokens[@]}"; do check_token "$spec"; done
fi
(( fails == 0 ))

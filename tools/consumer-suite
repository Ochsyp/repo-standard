#!/bin/sh
# tools/consumer-suite of repo-standard: builds a scratch consumer from what the MANIFEST vendors.
# CI runs the standard's suites there, where only the vendored files exist, as in every consumer.
# A test that needs a file only repo-standard holds, such as blocks/ or tools/, then fails before
# a release. It runs here only; it is not vendored.
#   tools/consumer-suite [--rev REV] [--shape public|private] DEST
# It rebuilds the MANIFEST from the index, or from the commit REV, with tools/manifest --print.
# So the consumer holds the files as the next release vendors them, even where the committed
# MANIFEST lags: a Dependabot pull request moves a workflow but cannot rebuild the MANIFEST. It
# builds the repository DEST, which must be missing or empty. The shape picks the consumer's
# config and what the MANIFEST gives it, as standard-check selects it:
#   public   VISIBILITY=public, LICENSE=MIT, RELEASE_KIND=tar (the default): the profiles all,
#            release, mit and public.
#   private  VISIBILITY=private, LICENSE=none, RELEASE_KIND=legacy: the profiles all and
#            private; release.yml and image.yml are the consumer's own, as under legacy (small
#            workflows that the general rules accept, image.yml callable as ci.yml calls it),
#            and no release block.
# Each file entry is written from the blob the entry names, with the entry's mode. Each block is
# written between its markers in its target file. DEST also holds the MANIFEST and the shape's
# .github/standard.conf (PRIVACY_RULES=base). It holds a VERSION and a CHANGELOG.md of its own,
# whose link names GITHUB_REPOSITORY when that is set, as release-meta requires. It holds a
# ci/test, a ci/test.ps1, and docs/fstab.example, a file of the consumer's own that only the disk
# pack reports. These files are committed once in a source repository and cloned into DEST, so
# the work tree has the line ends of a checkout: ci/test.ps1 gets CRLF. git runs without the
# global and the system config and without a template, so no hook, identity or setting of the
# machine takes part. git gets native paths, so MSYS_NO_PATHCONV does not move the clone. Then
# run the suites there:
#   bats DEST/.github/standard/tests/
set -eu

usage() {
    echo "usage: tools/consumer-suite [--rev REV] [--shape public|private] DEST" >&2
    exit 64
}

rev=
shape=public
dest=
while [ "$#" -gt 0 ]; do
    case $1 in
        --rev)
            [ "$#" -ge 2 ] || usage
            rev=$2
            shift
            ;;
        --shape)
            [ "$#" -ge 2 ] || usage
            case $2 in
                public | private) shape=$2 ;;
                *) usage ;;
            esac
            shift
            ;;
        -*) usage ;;
        *)
            [ -z "$dest" ] || usage
            dest=$1
            ;;
    esac
    shift
done
[ -n "$dest" ] || usage

fail() {
    printf 'consumer-suite: %s\n' "$1" >&2
    exit 2
}

# The absolute, native form of the folder $1 (C:/... in Git Bash, as git.exe reads it), with
# CDPATH off so that cd prints nothing.
native() {
    (CDPATH='' cd -- "$1" && { pwd -W 2> /dev/null || pwd; })
}

# Print the private shape's own workflow for the path $1 under RELEASE_KIND=legacy: small, held
# to the general rules of workflows.bats, and for image.yml callable as ci.yml's image job calls
# it, so actionlint accepts the call.
legacy_workflow() {
    case $1 in
        */image.yml)
            cat << 'EOF'
# image.yml of a scratch consumer: its own under RELEASE_KIND=legacy. ci.yml calls it only where
# IMAGE_PLATFORMS is set, and this consumer sets none.
name: image
on:
  workflow_call:
    inputs:
      push:
        type: boolean
        required: true
jobs:
  build:
    runs-on: ubuntu-26.04
    timeout-minutes: 5
    steps:
      - run: echo "This consumer builds no image."
EOF
            ;;
        *)
            cat << 'EOF'
# A release workflow of a scratch consumer: its own under RELEASE_KIND=legacy.
name: release
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  release:
    runs-on: ubuntu-26.04
    timeout-minutes: 5
    steps:
      - run: echo "This consumer releases by hand."
EOF
            ;;
    esac
}

top=$(git rev-parse --show-toplevel 2> /dev/null) || fail "not in a git work tree"
if [ -e "$dest" ] && [ -n "$(ls -A -- "$dest")" ]; then
    fail "$dest is not empty"
fi
mkdir -p -- "$dest" || fail "cannot create $dest"
dest=$(native "$dest") || fail "cannot enter $dest"
cd "$top"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/consumer-suite.XXXXXX") || exit 2
trap 'rm -rf -- "$tmp"' EXIT
tmp=$(native "$tmp") || fail "cannot enter the temp folder"
src=$tmp/source

# The MANIFEST, rebuilt from the commit REV or from the index.
if [ -n "$rev" ]; then
    git rev-parse --verify --quiet "$rev^{commit}" > /dev/null || fail "no commit $rev"
    sh tools/manifest --print --rev "$rev" > "$tmp/manifest" ||
        fail "tools/manifest cannot rebuild the MANIFEST"
else
    sh tools/manifest --print > "$tmp/manifest" || fail "tools/manifest cannot rebuild the MANIFEST"
fi

# The entries this consumer takes, as "type profile oid mode path" lines. A file or block line
# that does not parse, or names an unknown profile, stops the build.
SHAPE=$shape awk '
    /^#/ || /^[ \t]*$/ { next }
    $1 == "standard" { next }
    {
        if (($1 != "file" && $1 != "block") || NF != 5 || $2 !~ /^(all|release|mit|public|private|seal)$/) {
            printf "consumer-suite: the MANIFEST line %d does not parse\n", NR > "/dev/stderr"
            bad = 1
            next
        }
        if (ENVIRON["SHAPE"] == "public") take = $2 != "private" && $2 != "seal"
        else take = $2 == "all" || $2 == "private" || ($2 == "release" && $1 == "file")
        if (take) print $1, $2, $3, $4, $5
    }
    END { exit bad }' "$tmp/manifest" > "$tmp/entries" || exit 2
[ -s "$tmp/entries" ] || fail "the MANIFEST lists nothing"

# From here on git reads no global or system config and finds each repository by its folder.
: > "$tmp/gitconfig"
mkdir "$tmp/template"
GIT_CONFIG_GLOBAL=$tmp/gitconfig
GIT_CONFIG_NOSYSTEM=1
export GIT_CONFIG_GLOBAL GIT_CONFIG_NOSYSTEM
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
git init -q -b main --template="$tmp/template" "$src" || fail "cannot create the source repository"

while read -r type profile oid mode path; do
    case $type in
        file)
            mkdir -p -- "$src/$(dirname -- "$path")"
            if [ "$shape" = private ] && [ "$profile" = release ]; then
                legacy_workflow "$path" > "$src/$path"
            else
                git -C "$top" cat-file blob "$oid" > "$src/$path" ||
                    fail "cannot read the blob of $path: is the MANIFEST stale?"
            fi
            if [ "$mode" = 100755 ]; then chmod +x "$src/$path"; fi
            ;;
        block)
            target=${path%%#*}
            name=${path#*#}
            name=${name%%@*}
            mkdir -p -- "$src/$(dirname -- "$target")"
            case $target in
                *.md) begin="<!-- standard:begin $name -->" end="<!-- standard:end $name -->" ;;
                *) begin="# standard:begin $name" end="# standard:end $name" ;;
            esac
            {
                printf '%s\n' "$begin"
                git -C "$top" cat-file blob "$oid" ||
                    fail "cannot read the block $path: is the MANIFEST stale?"
                printf '%s\n' "$end"
            } >> "$src/$target"
            ;;
    esac
done < "$tmp/entries"
mkdir -p "$src/.github/standard"
cp "$tmp/manifest" "$src/.github/standard/MANIFEST"

{
    echo "# The config of a scratch consumer that tools/consumer-suite of repo-standard builds."
    echo "NAME=example"
    if [ "$shape" = public ]; then
        echo "VISIBILITY=public"
        echo "RELEASE_KIND=tar"
    else
        echo "VISIBILITY=private"
        echo "LICENSE=none"
        echo "RELEASE_KIND=legacy"
    fi
    echo "PRIVACY_RULES=base"
} > "$src/.github/standard.conf"
sh "$src/.github/standard/bin/conf" --check "$src/.github/standard.conf" ||
    fail "the consumer's config does not parse"

# A VERSION and a CHANGELOG.md of the consumer's own that release-meta accepts: no release yet,
# and a link that names the repository of the run, since release-meta requires the links to name it.
printf '0.1.0-dev\n' > "$src/VERSION"
{
    printf '%s\n' '# Changelog' '' \
        'All notable changes to this project are listed here. The format follows' \
        '[Keep a Changelog](https://keepachangelog.com/en/1.1.0/), and versions follow' \
        '[Semantic Versioning](https://semver.org/spec/v2.0.0.html). There are no releases yet.' \
        '' '## [Unreleased]' '' '### Added' '' '- A scratch consumer of the standard.' ''
    printf '[Unreleased]: https://github.com/%s/commits/main\n' \
        "${GITHUB_REPOSITORY:-example-owner/example}"
} > "$src/CHANGELOG.md"

mkdir -p "$src/ci" "$src/docs"
cat > "$src/ci/test" << 'EOF'
#!/bin/sh
# ci/test of a scratch consumer that tools/consumer-suite of repo-standard builds.
set -eu
echo "ci/test: no tests of its own"
EOF
chmod +x "$src/ci/test"
cat > "$src/ci/test.ps1" << 'EOF'
# ci/test.ps1 of a scratch consumer that tools/consumer-suite of repo-standard builds. Git stores
# it with LF; the .gitattributes block checks it out with CRLF.
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
EOF
# A FAT serial: the config's base pack passes it, the disk pack reports it. A vendored test that
# scans more than the standard's copies with every pack then fails here.
printf 'UUID=%s-%s  /boot/efi  vfat  umask=0077  0  1\n' 1A2B 3C4D > "$src/docs/fstab.example"

git -C "$src" -c core.safecrlf=false add -A || fail "cannot stage the files"
# git on Windows stages new files as 100644: give the executables their mode.
{
    awk '$1 == "file" && $4 == "100755" { print $5 }' "$tmp/entries"
    echo ci/test
} | xargs git -C "$src" update-index --chmod=+x -- || fail "cannot set the modes"
git -C "$src" -c user.name="Consumer Suite" -c user.email=consumer-suite@example.invalid \
    commit -q -m "chore: a scratch consumer of the standard" || fail "cannot commit"
git clone -q --template="$tmp/template" "$src" "$dest" || fail "cannot clone into $dest"
git -C "$dest" remote remove origin || fail "cannot remove the source remote"

# DEST holds the commit, and every file entry with the blob and the mode the MANIFEST names;
# under the private shape a release file is the consumer's own.
git -C "$dest" ls-files -s > "$tmp/files" || fail "cannot list $dest"
[ -s "$tmp/files" ] || fail "the clone did not land in $dest"
SHAPE=$shape awk 'NR == FNR {
        if ($1 == "file") {
            n++
            want[$5] = (ENVIRON["SHAPE"] == "private" && $2 == "release") ? $4 : $4 " " $3
        }
        next
    }
    {
        split($0, f, "\t"); split(f[1], m, " ")
        if (!(f[2] in want)) next
        if (want[f[2]] == m[1] " " m[2] || want[f[2]] == m[1]) ok++
    }
    END { exit ok != n }' "$tmp/entries" "$tmp/files" ||
    fail "$dest does not hold each file with the MANIFEST's blob and mode"

printf 'consumer-suite: %s holds %s file(s) and %s block(s) of standard %s, %s shape\n' "$dest" \
    "$(awk '$1 == "file"' "$tmp/entries" | awk 'END { print NR }')" \
    "$(awk '$1 == "block"' "$tmp/entries" | awk 'END { print NR }')" \
    "$(awk '$1 == "standard" { print $2; exit }' "$tmp/manifest")" "$shape"

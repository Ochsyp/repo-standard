#!/bin/bash
# tools/sync of repo-standard: writes a published release of the standard into the worktree of a
# repository of the standard, run from a clone of that release's tag:
#   tools/sync [--init] [--summary TEXT] --to DIR
# It refuses a clone that is not exactly the tag vX.Y.Z of its VERSION, a release that is a draft
# or not immutable, and a MANIFEST that differs from the release's MANIFEST asset. gh only reads.
# Then, in DIR, for the profiles that DIR's .github/standard.conf selects, as standard-check
# selects them:
#   1. it writes .githooks/ first, then every other copy, from the MANIFEST's blobs, and stages
#      each with its mode;
#   2. it replaces each block between its markers and never touches the text outside them;
#   3. it deletes the files that DIR's old MANIFEST lists and the release drops;
#   4. it writes the MANIFEST, whose blob id must equal the release's asset.
# Under RELEASE_KIND=legacy, DIR keeps its own release.yml and image.yml; one it lacks is written,
# since the standard needs both files and ci.yml calls image.yml. The releasing block waits for
# the release adoption. Under SEAL=yes a block's seal variant replaces the block of its name, and
# a block that exists only as a seal variant, such as SECURITY.md's sealed-releases, needs its
# markers in the file first. --init adopts a repository that has a config and no MANIFEST yet.
# It refuses a config that is not committed or differs from HEAD's: the hooks read it from HEAD.
# CONTRIBUTING.md and SECURITY.md come from templates/ where DIR has none. A block whose markers
# a file lacks is added at the head of a configuration file, or at the end of a document. At the
# adoption, a .github/dependabot.yml without a github-actions entry for / gets one at limit 0,
# right below the block. Last, it prints the pull request text: the changed files and blocks, the MANIFEST's
# blob id and the CHANGELOG line. --summary replaces the line's default summary. Paths of this
# machine are never printed. After that text, --init prints on stderr what the adoption must still
# fix by hand, then what the target's standard-check, privacy-scan and release-meta find in what
# sync staged, and points to repo-standard's CONTRIBUTING.md, Adopting a repository. Every run
# notes a seal-only block left in a file where SEAL is not yes. The notes give line numbers, blob
# ids, places and kinds, and never quote the repository's own text.
# Exit 0; 1 refused; 2 a step that cannot run; 64 usage.
if [ -z "${BASH_VERSION:-}" ]; then exec bash "$0" "$@"; fi
set -euo pipefail

usage() {
    echo "usage: tools/sync [--init] [--summary TEXT] --to DIR" >&2
    exit 64
}
say() { printf 'sync: %s\n' "$*" >&2; }
refuse() {
    say "$@"
    exit 1
}
fail() {
    say "$@"
    exit 2
}

init=0
summary=''
to=''
while (( $# )); do
    case $1 in
        --init) init=1 ;;
        --summary) [[ -n ${2:-} ]] || usage; summary=$2; shift ;;
        --to) [[ -n ${2:-} ]] || usage; to=$2; shift ;;
        *) usage ;;
    esac
    shift
done
[[ -n $to ]] || usage

umask 077
tmp=$(mktemp -d "${TMPDIR:-/tmp}/sync.XXXXXX") || fail "cannot create a temp folder"
trap 'rm -rf -- "$tmp"' EXIT

# The release: this clone at its tag, published, immutable, with the MANIFEST of its asset.
src=$(CDPATH='' cd -- "${BASH_SOURCE[0]%/*}/.." && pwd)
src=$(git -C "$src" rev-parse --show-toplevel 2> /dev/null) || fail "tools/sync runs from a clone of repo-standard"
version=$(git -C "$src" show HEAD:VERSION 2> /dev/null | tr -d '\r') || fail "the clone has no VERSION"
[[ $version =~ ^(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})$ ]] ||
    refuse "VERSION $version is no release; clone a published tag"
tag=v$version
tagged=$(git -C "$src" rev-parse -q --verify "refs/tags/$tag^{commit}" 2> /dev/null) || tagged=''
[[ $(git -C "$src" rev-parse HEAD) == "$tagged" ]] ||
    refuse "this clone is not at the tag $tag: clone the release with --branch $tag"
[[ -z $(git -C "$src" status --porcelain --untracked-files=no) ]] ||
    refuse "this clone has changes; use a fresh clone of $tag"
manifest=$src/.github/standard/MANIFEST
[[ $(awk '$1 == "standard" && NF == 2 { print $2; exit }' "$manifest") == "$version" ]] ||
    refuse "the MANIFEST names another version than $version"
url=$(git -C "$src" remote get-url origin 2> /dev/null) || refuse "the clone has no origin"
slug=${url%/}
slug=${slug%.git}
case $slug in
    https://github.com/*) slug=${slug#https://github.com/} ;;
    git@github.com:*) slug=${slug#git@github.com:} ;;
    ssh://git@github.com/*) slug=${slug#ssh://git@github.com/} ;;
    *) refuse "the clone's origin is not on github.com" ;;
esac
[[ $slug =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || refuse "the clone's origin names no repository"
state=$(gh api "repos/$slug/releases/tags/$tag" --jq '[.draft, .immutable] | @tsv') ||
    refuse "cannot read the release $tag"
IFS=$'\t' read -r draft immutable <<< "$state"
[[ $draft == false ]] || refuse "$tag is not a published release"
[[ $immutable == true ]] || refuse "$tag is not immutable"
mkdir "$tmp/asset"
gh release download "$tag" -R "$slug" --pattern MANIFEST --dir "$tmp/asset" > /dev/null ||
    refuse "cannot download the MANIFEST asset of $tag"
asset=$(git hash-object --no-filters "$tmp/asset/MANIFEST")
[[ $asset == "$(git -C "$src" rev-parse HEAD:.github/standard/MANIFEST)" ]] ||
    refuse "the MANIFEST differs from the release's MANIFEST asset"

# The target and its profiles.
[[ -d $to ]] || refuse "the target is no folder"
dir=$(git -C "$to" rev-parse --show-toplevel 2> /dev/null) || refuse "the target is not a git work tree"
[[ -f $dir/.github/standard.conf ]] ||
    refuse "the target has no .github/standard.conf; write it from templates/standard.conf first"
# The hooks and privacy-scan read the config from HEAD, and before its first commit they run no
# rule pack, so an adoption needs it committed as it stands. HEAD is read without a REV:PATH
# argument, which Git Bash may rewrite.
if (( init )); then
    entry=''
    if git -C "$dir" rev-parse --quiet --verify HEAD > /dev/null; then
        entry=$(git -C "$dir" ls-tree HEAD -- .github/standard.conf) ||
            fail "cannot read the target's HEAD"
    fi
    [[ $entry == *' blob '* ]] ||
        refuse "the target's .github/standard.conf is not committed; commit it on its own first," \
            "since the hooks and privacy-scan read it from HEAD"
    differs=0
    git -C "$dir" diff --quiet HEAD -- .github/standard.conf || differs=$?
    (( differs != 1 )) ||
        refuse "the target's .github/standard.conf differs from the committed one; commit it on its" \
            "own first"
    (( differs == 0 )) || fail "cannot compare the target's .github/standard.conf with HEAD's"
fi
conf() {
    sh "$src/.github/standard/bin/conf" --get "$1" "$dir/.github/standard.conf" ||
        refuse "cannot read $1 from the target's .github/standard.conf"
}
sh "$src/.github/standard/bin/conf" --check "$dir/.github/standard.conf" > /dev/null ||
    refuse "the target's .github/standard.conf does not parse (above)"
[[ $(conf ROLE) != source ]] || refuse "the target is repo-standard itself (ROLE=source)"
kind=$(conf RELEASE_KIND)
old=$dir/.github/standard/MANIFEST
if (( init )); then
    [[ ! -e $old ]] || refuse "the target has a MANIFEST already; sync it without --init"
else
    [[ -f $old ]] || refuse "the target has no .github/standard/MANIFEST; adopt it with --init"
fi
# Under SEAL=yes a block's seal variant replaces the block of its name.
VIS=$(conf VISIBILITY) LIC=$(conf LICENSE) SEAL=$(conf SEAL) awk '
    /^#/ || /^[ \t]*$/ || ($1 == "standard" && NF == 2) { next }
    ($1 != "file" && $1 != "block") || NF != 5 { bad = 1; next }
    {
        p = $2
        if (p == "all" || p == "release") sel = 1
        else if (p == "mit") sel = ENVIRON["LIC"] == "MIT"
        else if (p == "public" || p == "private") sel = ENVIRON["VIS"] == p
        else if (p == "seal") sel = ENVIRON["SEAL"] == "yes"
        else { bad = 1; next }
        name = $5; sub(/@.*/, "", name)
        if ($1 == "block" && p == "seal") sealed[name] = 1
        if (sel) { n++; entry[n] = $0; type[n] = $1; prof[n] = p; base[n] = name }
    }
    END {
        for (i = 1; i <= n; i++)
            if (type[i] != "block" || prof[i] == "seal" || !(base[i] in sealed) || ENVIRON["SEAL"] != "yes")
                print entry[i]
        exit bad
    }' "$manifest" > "$tmp/entries" || refuse "the MANIFEST holds a line that sync does not know"
# Every blob must be readable before the first write, so a damaged clone leaves DIR untouched.
while read -r _ _ oid _ path; do
    git -C "$src" cat-file -e "$oid" 2> /dev/null || fail "cannot read the blob of $path"
done < "$tmp/entries"

if (( init )); then
    line="- Repository standard $version: ${summary:-adopted, with the hooks, checks, workflows and blocks}."
else
    line="- Repository standard $version: ${summary:-the copies and blocks of this release}."
fi

changed_files=()
changed_blocks=()
removed=()
# For the notes of --init, each as "file TAB name": blocks added at the end of an existing
# document, and the blocks of configuration files that existed.
appended=()
config_blocks=()
notes=()

# Write the copy at $3 from the blob $1 with the mode $2, and stage it with that mode.
copy() {
    local oid=$1 mode=$2 path=$3 before after
    before=$(git -C "$dir" ls-files -s -- "$path" | awk '{ print $1 " " $2 }')
    mkdir -p "$dir/$(dirname -- "$path")"
    git -C "$src" cat-file blob "$oid" > "$dir/$path" || fail "cannot write $path"
    if [[ $mode == 100755 ]]; then chmod +x "$dir/$path"; else chmod -x "$dir/$path"; fi
    git -C "$dir" add -- "$path" || fail "cannot stage $path"
    if [[ $mode == 100755 ]]; then
        git -C "$dir" update-index --chmod=+x -- "$path"
    else
        git -C "$dir" update-index --chmod=-x -- "$path"
    fi
    after=$(git -C "$dir" ls-files -s -- "$path" | awk '{ print $1 " " $2 }')
    [[ $after == "$mode $oid" ]] ||
        refuse "$path: the target stages another blob than the MANIFEST names (a filter or attribute changes it)"
    [[ $before == "$after" ]] || changed_files+=("$path")
}

# 1. .githooks/ first, so the next commit runs the new hooks, then the other copies.
for pass in hooks rest; do
    while read -r type profile oid mode path; do
        [[ $type == file ]] || continue
        if [[ $pass == hooks ]]; then [[ $path == .githooks/* ]] || continue; else [[ $path != .githooks/* ]] || continue; fi
        if [[ $profile == release && $kind == legacy && -e $dir/$path ]]; then
            continue
        fi
        copy "$oid" "$mode" "$path"
    done < "$tmp/entries"
done

# Print the open-pull-requests-limit of the github-actions entry for / in file $1: "none" when
# the entry sets none, "absent" without the entry. standard-check's rule 6 reads it the same way.
actions_limit() {
    tr -d '\r' < "$1" | awk '
        function value(s) { sub(/^[^:]*:[ \t]*/, "", s); sub(/[ \t]+#.*$/, "", s); gsub(/["\047]/, "", s); return s }
        function flush() { if (eco == "github-actions" && dir == "/") { found = 1; out = (lim == "") ? "none" : lim } }
        /^[ \t]*-[ \t]+package-ecosystem:/ { flush(); eco = value($0); dir = ""; lim = ""; next }
        /^[ \t]+directory:/ { dir = value($0) }
        /^[ \t]+open-pull-requests-limit:/ { lim = value($0) }
        END { flush(); print found ? out : "absent" }'
}

# 2. The blocks, between their markers.
actions_added=0
while read -r type profile oid _ path; do
    [[ $type == block ]] || continue
    [[ $profile != release || $kind != legacy ]] || continue
    target=${path%%#*}
    name=${path#*#}
    name=${name%%@*}
    case $target in
        *.md) begin="<!-- standard:begin $name -->" end="<!-- standard:end $name -->" ;;
        *) begin="# standard:begin $name" end="# standard:end $name" ;;
    esac
    file=$dir/$target
    created=0
    if [[ ! -e $file ]]; then
        (( init )) || refuse "$target is missing, and only --init creates it"
        mkdir -p "$(dirname -- "$file")"
        if [[ -f $src/templates/$target ]]; then cp "$src/templates/$target" "$file"; else : > "$file"; fi
        created=1
    fi
    begins=$(tr -d '\r' < "$file" | grep -c -x -F -e "$begin" || true)
    ends=$(tr -d '\r' < "$file" | grep -c -x -F -e "$end" || true)
    added=0
    if [[ $begins == 0 && $ends == 0 ]]; then
        (( init )) || refuse "$target: the markers of the block $name are missing"
        added=1
        case $target in
            *.md) printf '\n%s\n%s\n' "$begin" "$end" >> "$file" ;;
            *) { printf '%s\n%s\n' "$begin" "$end"; cat "$file"; } > "$tmp/head" && cp "$tmp/head" "$file" ;;
        esac
    elif [[ $begins != 1 || $ends != 1 ]]; then
        refuse "$target: the block $name needs one begin and one end marker"
    fi
    git -C "$src" cat-file blob "$oid" > "$tmp/body" || fail "cannot read the block $path"
    if (( init && ! created )); then
        case $target in
            *.md) if (( added )); then appended+=("$target"$'\t'"$name"); fi ;;
            *) config_blocks+=("$target"$'\t'"$name") ;;
        esac
    fi
    BEGIN_LINE=$begin END_LINE=$end BODY=$tmp/body awk '
        { line = $0; sub(/\r$/, "", line) }
        line == ENVIRON["BEGIN_LINE"] {
            print line
            while ((getline body < ENVIRON["BODY"]) > 0) print body
            inside = 1
            seen = 1
            next
        }
        line == ENVIRON["END_LINE"] { if (!inside) bad = 1; inside = 0; print line; next }
        !inside { print }
        END { exit bad || !seen || inside }' "$file" > "$tmp/new" ||
        refuse "$target: the end marker of the block $name comes before its begin"
    if (( created )) && [[ $target == .github/dependabot.yml ]]; then
        printf '%s\n' '  - package-ecosystem: github-actions' '    directory: /' '    schedule:' \
            '      interval: weekly' '    open-pull-requests-limit: 0' >> "$tmp/new"
    elif (( init )) && [[ $target == .github/dependabot.yml &&
        $(actions_limit "$tmp/new") == absent ]]; then
        # At the adoption, an existing file without the entry gets it right below the block,
        # where the block's updates list goes on; standard-check refuses the file without it. A
        # later sync changes nothing outside the markers and keeps its note.
        END_LINE=$end awk '
            { print; line = $0; sub(/\r$/, "", line) }
            line == ENVIRON["END_LINE"] && !done {
                print "  - package-ecosystem: github-actions"; print "    directory: /"
                print "    schedule:"; print "      interval: weekly"
                print "    open-pull-requests-limit: 0"; done = 1
            }' "$tmp/new" > "$tmp/new.actions" || fail "cannot add the github-actions entry"
        cp "$tmp/new.actions" "$tmp/new"
        actions_added=1
    fi
    if ! cmp -s "$tmp/new" "$file"; then
        cp "$tmp/new" "$file"
    fi
    before=$(git -C "$dir" ls-files -s -- "$target" | awk '{ print $2 }')
    git -C "$dir" add -- "$target" || fail "cannot stage $target"
    [[ $(git -C "$dir" ls-files -s -- "$target" | awk '{ print $2 }') == "$before" ]] ||
        changed_blocks+=("$target#$name")
done < "$tmp/entries"

# 3. The files the release drops.
if (( ! init )); then
    awk '$1 == "file" && NF == 5 { print $5 }' "$old" | LC_ALL=C sort -u > "$tmp/old.paths"
    awk '$1 == "file" && NF == 5 { print $5 }' "$manifest" | LC_ALL=C sort -u > "$tmp/new.paths"
    while IFS= read -r path; do
        [[ -n $path ]] || continue
        if [[ -n $(git -C "$dir" ls-files -- "$path") ]]; then
            git -C "$dir" rm -q -f -- "$path" || fail "cannot delete $path"
            removed+=("$path")
        fi
    done < <(LC_ALL=C comm -23 "$tmp/old.paths" "$tmp/new.paths")
fi

# 4. The MANIFEST, equal to the asset.
mkdir -p "$dir/.github/standard"
cp "$manifest" "$old"
git -C "$dir" add -- .github/standard/MANIFEST || fail "cannot stage the MANIFEST"
[[ $(git -C "$dir" rev-parse :.github/standard/MANIFEST) == "$asset" ]] ||
    refuse "the target stages another MANIFEST than the release's asset"

# 5. Under --init, what the adoption must still fix by hand.
note() { notes+=("$*"); }
if (( actions_added )); then
    note ".github/dependabot.yml: sync added the github-actions entry for / at" \
        "open-pull-requests-limit: 0 below the block's end marker."
fi

# Turn line numbers on stdin into "line N" or "lines N, M"; nothing for no input.
at_lines() {
    awk '{ out = out (NR > 1 ? ", " : "") $0 } END { if (NR) print (NR > 1 ? "lines " : "line ") out }'
}

# Print the numbers of the lines of file $1 outside block $2 that repeat the block. In YAML a
# top-level key counts. In .editorconfig only root and section headers do, because a setting may
# rightly recur under another section. Elsewhere any line that is not a comment counts.
repeated_lines() {
    tr -d '\r' < "$1" > "$tmp/config"
    BASE=${1##*/} NAME=$2 awk '
        function key(s) {
            if (ENVIRON["BASE"] == "dependabot.yml")
                return s ~ /^[A-Za-z_-]+:/ ? substr(s, 1, index(s, ":")) : ""
            gsub(/^[ \t]+|[ \t]+$/, "", s)
            if (s == "" || s ~ /^[#;]/) return ""
            if (ENVIRON["BASE"] == ".editorconfig") {
                if (tolower(s) ~ /^root[ \t]*=/) return "root"
                return s ~ /^\[.*\]$/ ? s : ""
            }
            gsub(/[ \t]+/, " ", s)
            return s
        }
        BEGIN { b = "# standard:begin " ENVIRON["NAME"]; e = "# standard:end " ENVIRON["NAME"] }
        $0 == b { inside = 1; next }
        $0 == e { inside = 0; next }
        FNR == NR { if (inside && (k = key($0)) != "") want[k] = 1; next }
        !inside && (key($0) in want) { print FNR }' "$tmp/config" "$tmp/config"
}

if (( init )); then
    numbered=0
    for entry in "${config_blocks[@]}"; do
        IFS=$'\t' read -r target name <<< "$entry"
        at=$(repeated_lines "$dir/$target" "$name" | at_lines)
        if [[ -n $at ]]; then
            numbered=1
            if [[ $at == lines* ]]; then verb=repeat; else verb=repeats; fi
            case $target in
                .github/dependabot.yml)
                    note "$target: $at $verb the block's version or updates." \
                        "Delete the repeated version and updates. Then put your entries directly" \
                        "below the block's end marker, and any other top-level key such as" \
                        "registries after them." ;;
                .editorconfig)
                    note "$target: $at $verb the block's root or a section header." \
                        "Delete a repeated root, and a repeated section with its settings," \
                        "unless they override the block on purpose." ;;
                *)
                    note "$target: $at $verb the block. The last matching line wins, so check" \
                        "whether a line of yours relies on the repeat before you delete it." ;;
            esac
        fi
        if [[ $target == .github/dependabot.yml ]]; then
            case $(actions_limit "$dir/$target") in
                0) ;;
                absent)
                    note "$target: add a github-actions entry for / with open-pull-requests-limit: 0." \
                        "standard-check refuses the file without it." ;;
                *)
                    note "$target: set open-pull-requests-limit: 0 on the github-actions entry for /." \
                        "standard-check refuses the file without it." ;;
            esac
        fi
    done
    if (( numbered )); then
        notes=("Line numbers hold for the files as sync left them. In each file, delete from the last line up, then move what the notes say to move." "${notes[@]}")
    fi
    if [[ -e $dir/.github/dependabot.yaml ]]; then
        note ".github/dependabot.yaml stands beside .github/dependabot.yml, the file the standard" \
            "checks. Move your entries into it, leaving out any github-actions entry for / and any" \
            "entry for a package-ecosystem, directory and target-branch it already covers, and put" \
            "other top-level keys such as registries after them. Then delete the .yaml file."
    fi
    # Which older section a block replaces is the reader's call: a heading alone cannot show it.
    for entry in "${appended[@]}"; do
        IFS=$'\t' read -r target name <<< "$entry"
        note "$target: the block $name was appended at the end. An older section on the same" \
            "topic may stand beside it, so compare them by eye. templates/$target shows where" \
            "the block goes."
    done
    if ! grep -q -i -E '^#{1,6}[[:space:]]+Checks[[:space:]]*$' "$dir/CONTRIBUTING.md"; then
        note "CONTRIBUTING.md: add a ## Checks section. The workflow block points to it."
    fi
    if [[ ! -f $dir/CHANGELOG.md ]]; then
        note "CHANGELOG.md: write it from templates/CHANGELOG.md, then add under ### Changed: $line"
    elif ! grep -q -F -e "$line" "$dir/CHANGELOG.md"; then
        note "CHANGELOG.md: add under ### Changed: $line"
    fi
    # As in the size guard, every tracked blob but a submodule is checked and named by id, since a
    # path may hold a private term. The limit is the one the hooks read: HEAD's MAX_BLOB_KB, or
    # 1024 when HEAD has none that parses.
    limit=1024
    if git -C "$dir" cat-file -e HEAD:.github/standard.conf 2> /dev/null; then
        git -C "$dir" cat-file blob HEAD:.github/standard.conf > "$tmp/head.conf" &&
            limit=$(sh "$src/.github/standard/bin/conf" --get MAX_BLOB_KB "$tmp/head.conf" 2> /dev/null) ||
            limit=1024
    fi
    if git -C "$dir" ls-files -s | awk '$1 != "160000" && $3 == 0 { print $2 }' | LC_ALL=C sort -u |
        git -C "$dir" cat-file --batch-check='%(objectname) %(objectsize)' > "$tmp/sizes"; then
        big=0
        while read -r short kb; do
            if [[ $kb == missing ]]; then
                note "blob $short could not be read, so its size was not compared." \
                    "Find its file with: git ls-files -s | grep $short"
                continue
            fi
            big=1
            note "blob $short is $kb KB, above MAX_BLOB_KB=$limit." \
                "A commit that edits its file and leaves it this large is refused." \
                "Find its file with: git ls-files -s | grep $short"
        done < <(awk -v limit="$limit" '
            $2 == "missing" { print substr($1, 1, 12), "missing"; next }
            $2 > limit * 1024 { print substr($1, 1, 12), int(($2 + 1023) / 1024) }' "$tmp/sizes")
        if (( big )); then
            note "Raise MAX_BLOB_KB in .github/standard.conf first, in a commit of its own:" \
                "the hooks read the limit from HEAD. Once the config is on main, that commit needs" \
                "its own chore/privacy-* pull request."
        fi
    else
        note "the sizes of the tracked files could not be read, so MAX_BLOB_KB was not compared."
    fi
    # Last, the target's own checks, run on what sync left staged, so the owner sees at once what
    # is left. They print places, kinds and counts, never a value.
    relay() {
        local line n=0
        while IFS= read -r line; do
            line=${line%$'\r'}
            case $line in
                "" | "$1: ok" | "$1: hooks: "* | "$1: denylists: "*) continue ;;
            esac
            n=$((n + 1))
            if (( n <= 20 )); then note "$line"; fi
        done
        if (( n > 20 )); then
            note "$1: $((n - 20)) more line(s); run it in the target to see them."
        fi
    }
    # Outside Actions, so the checks write plain lines, not annotations, wherever sync runs.
    relay standard-check < <(cd "$dir" &&
        env -u GITHUB_ACTIONS sh .github/standard/bin/standard-check --staged 2>&1 > /dev/null)
    relay privacy-scan < <(cd "$dir" &&
        env -u GITHUB_ACTIONS sh .githooks/privacy-scan --tracked 2>&1 > /dev/null)
    relay release-meta < <(cd "$dir" && git tag -l 'v*' |
        env -u GITHUB_ACTIONS bash .github/standard/bin/release-meta check 2>&1 > /dev/null)
    note "repo-standard's CONTRIBUTING.md, Adopting a repository, lists the steps that are left:" \
        "the ci/ stages, the GitHub settings and the maintainer's git setup."
fi

# A block that exists only as a seal variant, such as SECURITY.md's sealed-releases, stays
# behind when SEAL is not yes, and standard-check refuses it there.
if [[ $(conf SEAL) != yes ]]; then
    while read -r target name; do
        case $target in
            *.md) begin="<!-- standard:begin $name -->" ;;
            *) begin="# standard:begin $name" ;;
        esac
        [[ -f $dir/$target ]] || continue
        grep -q -x -F -e "$begin" -e "$begin"$'\r' "$dir/$target" || continue
        note "$target: the block $name is for SEAL=yes only. Delete it with its markers," \
            "or standard-check fails."
    done < <(awk '$1 == "block" && NF == 5 {
            target = $5; sub(/#.*/, "", target); name = $5; sub(/^[^#]*#/, "", name)
            sub(/@.*/, "", name)
            if ($2 == "seal") seal[target " " name] = 1; else plain[target " " name] = 1
        }
        END { for (b in seal) if (!(b in plain)) print b }' "$manifest")
fi

# The pull request text, checked for the names too.
list() {
    printf '%s:\n' "$1"
    shift
    if (( $# )); then printf -- '- %s\n' "$@"; else printf -- '- none\n'; fi
    printf '\n'
}
{
    printf '## What and why\n\n'
    printf 'Repository standard %s, written by tools/sync from the published, immutable release %s.\n' \
        "$version" "$tag"
    printf "The MANIFEST's blob id is %s, the same as the release's MANIFEST asset.\n\n" "$asset"
    list "Changed files" "${changed_files[@]}"
    list "Changed blocks" "${changed_blocks[@]}"
    list "Removed files" "${removed[@]}"
    printf 'CHANGELOG line, under ### Changed:\n\n%s\n\n' "$line"
    printf '## Phase\n\nnone\n\n## Release impact\n\nnone\n\n## Checks on the target\n\nnone\n\n'
    printf '## Checklist\n\n'
    # The backticks are Markdown's, as in the pull request template.
    # shellcheck disable=SC2016
    printf '%s\n' '- [ ] One phase or one change in this pull request' \
        '- [ ] `CHANGELOG.md` has an entry under Unreleased, unless this is a release pull request or' \
        '      the fix of a draft release' \
        '- [ ] The checks in CONTRIBUTING.md, Checks, pass, and no test was skipped (no-skips reads bats' \
        '      output only, so check the log of any other test stage)' \
        '- [ ] No private data in the change, the title, this text or the branch name: no personal names,' \
        '      paths, host names, addresses, hardware or VM identifiers, real logs or secrets; examples' \
        '      use the synthetic values in CONTRIBUTING.md, Test data' '' \
        'CONTRIBUTING.md describes the workflow.'
} > "$tmp/text"
cat "$tmp/text"
for entry in "${notes[@]}"; do
    say "note: $entry"
done

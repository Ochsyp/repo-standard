#!/bin/bash
# ci/test of repo-standard: the test stage on Windows (CI_RUNNER=windows), in Git Bash. It runs
# the bats tests of tools/, then the standard's suites except hooks.bats and privacy-scan.bats,
# which the job hooks-windows runs. Neither run takes the tests tagged lint; ci/system runs those
# on Linux. Then no-skips checks both runs. One run of the suites takes about a quarter of an hour
# in Git Bash, so the two scratch consumers run in ci/system only, where the job's 30 minutes hold
# them. run-stage runs ci/test.ps1 next: the smoke test of the pinned PowerShell modules.
set -euo pipefail
dir=${RUNNER_TEMP:-${TMPDIR:-/tmp}}/repo-standard-test
if [[ -e $dir ]]; then
    echo "ci/test: $dir exists; remove it first" >&2
    exit 1
fi
mkdir -p "$dir"
bin=$(.github/standard/bin/install-tools bats)
PATH=$bin:$PATH

# Run the standard's suites of the repository at $2, except the two of hooks-windows and the
# tests tagged lint. The TAP stream also goes to the file $1.
suites() {
    local tap=$1 root=$2 file
    local -a files=()
    for file in "$root"/.github/standard/tests/*.bats; do
        case ${file##*/} in
            hooks.bats | privacy-scan.bats) ;;
            *) files+=("$file") ;;
        esac
    done
    bats --tap --filter-tags '!lint' "${files[@]}" | tee "$tap"
}

status=0
bats --tap --filter-tags '!lint' tests/ | tee "$dir/tools.tap" || status=1
suites "$dir/standard.tap" . || status=1
.github/standard/bin/no-skips "$dir/tools.tap" "$dir/standard.tap" || status=1
exit "$status"

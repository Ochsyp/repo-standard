#!/bin/bash
# ci/test of repo-standard: the test stage on Windows (CI_RUNNER=windows), in Git Bash. It runs
# only the suites of the code that runs on Windows: conf.bats, the tests of run-stage and
# install-tools in standard-check.bats, and tests/release-seal.bats. The job hooks-windows runs
# hooks.bats and privacy-scan.bats. Every suite runs on Linux, in the job standard and in
# ci/system; in Git Bash all of them took 23 of the job's 30 minutes. Then no-skips checks each
# run. run-stage runs ci/test.ps1 next: the smoke test of the pinned PowerShell modules and the
# Pester tests of the seal dialog.
set -euo pipefail
dir=${RUNNER_TEMP:-${TMPDIR:-/tmp}}/repo-standard-test
if [[ -e $dir ]]; then
    echo "ci/test: $dir exists; remove it first" >&2
    exit 1
fi
mkdir -p "$dir"
bin=$(.github/standard/bin/install-tools bats)
PATH=$bin:$PATH
suites=.github/standard/tests

status=0
bats --tap "$suites/conf.bats" tests/release-seal.bats | tee "$dir/suites.tap" || status=1
# The tests are picked by the start of their names; a renamed one drops out of this run.
bats --tap --filter '^(run-stage|install-tools) ' "$suites/standard-check.bats" |
    tee "$dir/stages.tap" || status=1
.github/standard/bin/no-skips "$dir/suites.tap" "$dir/stages.tap" || status=1
exit "$status"
